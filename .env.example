# Local DNS name for the Mac mini. Create this record on your router/DNS server.
SERVER_NAME=llama.home.arpa

# nginx listens on this LAN-facing port.
LISTEN_PORT=80

# llama-server remains private on loopback; nginx proxies to it.
LLAMA_PORT=8080

# Hugging Face GGUF repository and quantization.
# A 1B Q4 model is a conservative starting point for an Intel Mac mini.
LLAMA_MODEL=ggml-org/gemma-3-1b-it-GGUF:Q4_K_M
LLAMA_CTX_SIZE=4096
LLAMA_PARALLEL=1

# Leave empty to let llama.cpp select its backend.
# Set to "none" to force CPU-only execution if the Intel Metal backend is unstable.
LLAMA_DEVICE=

# Optional. Leave empty for llama.cpp defaults.
LLAMA_THREADS=
LLAMA_GPU_LAYERS=

# Optional API authentication. The web UI will require this key when set.
# This file is installed root-owned because launchd reads it at startup.
LLAMA_API_KEY=
