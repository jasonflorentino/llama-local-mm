SERVER_NAME=llama.home.arpa
LISTEN_PORT=80
LLAMA_PORT=8080

LLAMA_MODEL=ggml-org/gemma-3-1b-it-GGUF:Q4_K_M
LLAMA_CTX_SIZE=4096
LLAMA_PARALLEL=1

# Macmini8,1 / Intel UHD 630
LLAMA_DEVICE=none
LLAMA_GPU_LAYERS=0

# Six physical cores, twelve logical CPUs
LLAMA_THREADS=6
LLAMA_THREADS_BATCH=12

# Maximum prompt-cache storage in MiB
LLAMA_CACHE_RAM=1024

# Optional authentication
LLAMA_API_KEY=
