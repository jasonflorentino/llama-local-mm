# Local DNS name for the Mac mini. Create this record on your router/DNS server.
SERVER_NAME=llama.home.arpa

# nginx listens on this LAN-facing port.
LISTEN_PORT=80

# llama-server remains private on loopback; nginx proxies to it.
# Avoid Homebrew nginx's commonly used default port 8080.
LLAMA_PORT=18080

# Hugging Face GGUF repository and quantization.
# A 1B Q4 model is a conservative starting point for an Intel Mac mini.
LLAMA_MODEL=ggml-org/gemma-3-1b-it-GGUF:Q4_K_M
# Keep this API-facing name stable when LLAMA_MODEL changes so saved clients do
# not need to be reconfigured after an administrator switches models.
LLAMA_MODEL_ALIAS=home-llama
LLAMA_CTX_SIZE=4096
LLAMA_PARALLEL=1

# Allow large first-time model downloads and CPU-only startup to take up to 30
# minutes before setup considers the new model unhealthy and restores control.
LLAMA_STARTUP_TIMEOUT=1800

# Macmini8,1 / Intel UHD 630: use CPU inference. llama.cpp's supported Metal
# backend targets Apple Silicon, and this Intel GPU has very limited VRAM.
LLAMA_DEVICE=none
# Leave empty in CPU-only mode so llama-server does not receive a redundant
# --gpu-layers option.
LLAMA_GPU_LAYERS=

# Use the six physical cores for token generation. Prompt ingestion may benefit
# from all twelve logical CPUs provided by Hyper-Threading.
LLAMA_THREADS=6
LLAMA_THREADS_BATCH=12

# Maximum server prompt-cache storage in MiB. llama-server currently defaults
# to 8192 MiB, which is unnecessarily high for a single-user 16 GB machine.
LLAMA_CACHE_RAM=1024

# Leave empty to restrict CORS automatically to http://SERVER_NAME[:port].
# Specify a comma-separated list only when additional browser origins are needed.
LLAMA_CORS_ORIGINS=

# Optional API authentication. The web UI will require this key when set.
# The generated runtime file remains readable only by the service user.
LLAMA_API_KEY=
